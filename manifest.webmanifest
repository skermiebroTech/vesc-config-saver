    { "name": "Ride logger", "url": "logger.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Compare configs", "url": "compare.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
